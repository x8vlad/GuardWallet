<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="clr-namespace:GuardWallet.Views"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="GuardWallet.Views.AuthorizationWindow"
        Background="#121212"
        Title="Authorization"
        x:DataType="views:AuthorizationWindow">
    <StackPanel
        Spacing="16" Margin="16">
        <Border Margin="5" Background="#6366F1" CornerRadius="10">
            <TextBlock 
                Text="Authorization to bank profile"
                Margin="5"
                FontSize="23"
                HorizontalAlignment="Center" 
                VerticalAlignment="Center"/>
        </Border>
        <GroupBox Header="Authorization Details">
            <StackPanel Spacing="8">
                <TextBox Text="{Binding userLogin}"  PlaceholderText="Name.." />
                <TextBox Text="{Binding userPassword}" PlaceholderText="Password.." />
            </StackPanel>
        </GroupBox>
        <GroupBox Header="Preferences">
            <StackPanel Spacing="8">
                <CheckBox IsChecked="True" Content="Dark mode" />
            </StackPanel>
        </GroupBox>
                
        <GroupBox Header="Authorization">
            <StackPanel Spacing="8" Orientation="Horizontal">
                <Button Background="#6366F1" Click="LoginButton_OnClick">
                    Authorization
                </Button>
                      
                <Button Background="#6366F1">
                    Register
                </Button>
            </StackPanel>
        </GroupBox>
                
    </StackPanel>
</Window>
